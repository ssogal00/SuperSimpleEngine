
struct PixelInputType
{
    float4 InPosition : SV_POSITION;
    float4 InViewPosition : COLOR0;
    float2 InTexCoord : TEXCOORD0;
    float3 InNormal : NORMALWS;
    float3 InTangent : TANGENTWS;
    float3 InBitangent : BITANGENTWS;
};

#ifdef DIFFUSETEX_EXIST
Texture2D DiffuseTex;
#endif

#ifdef NORMALTEX_EXIST
Texture2D NormalTex;
#endif

#if defined(METALICTEX_EXIST) && defined(ROUGHNESSTEX_EXIST)
Texture2D OcclusionRoughnessMetalicTex; // OcclusionRoughnessMetalic Texture
#endif

SamplerState DefaultTexSampler : register(s0);


struct PixelOutputType
{
    float4 DiffuseColor : SV_Target0;
    float4 PositionColor: SV_Target1;    
    float4 NormalColor : SV_Target2;   
};

cbuffer MetalicRoughness
{
    float Metalic = 0.9;
    float Roughness = 0.9;
};

cbuffer CBDiffuseColor
{
    float3 DiffuseOverride;
};

cbuffer TextureStreamingInfo : register(b5)
{
    float4 DiffuseStreamInfo;
    float4 NormalStreamInfo;
    float4 RoughnessStreamInfo;
    float4 MetalicStreamInfo;
};

float4 SampleStreaming(Texture2D tex, SamplerState samp, float2 uv, float4 streamInfo)
{
    // Sample at mip 0 outside of dynamic branch to ensure valid gradients
    float4 result = tex.SampleLevel(samp, uv, 0);

    if (streamInfo.x > 0.0)
    {
        float4 coarse = tex.SampleLevel(samp, uv, streamInfo.x);
        float4 finer = tex.SampleLevel(samp, uv, max(streamInfo.y, 0.0));
        result = lerp(coarse, finer, streamInfo.z);
    }

    return result;
}


PixelOutputType PSMain(PixelInputType pin)
{   
    PixelOutputType output = (PixelOutputType)0;; 

#ifdef DIFFUSETEX_EXIST
    output.DiffuseColor = SampleStreaming(DiffuseTex, DefaultTexSampler, pin.InTexCoord, DiffuseStreamInfo);
#else
    output.DiffuseColor = float4(DiffuseOverride,0); 
#endif

#ifdef ROUGHNESSTEX_EXIST
    {
        output.DiffuseColor.a = SampleStreaming(OcclusionRoughnessMetalicTex, DefaultTexSampler, pin.InTexCoord, RoughnessStreamInfo).y;
    }
#else
    {
        output.DiffuseColor.a = Roughness;
    }
#endif

    if(pin.InPosition.w == 0)
    {
        output.DiffuseColor = float4(1,0,0,0);
    }

    
    
    float3x3 TangentToModelViewSpaceMatrix = float3x3( normalize(pin.InTangent),
                                                       normalize(pin.InBitangent),
                                                       normalize(pin.InNormal)
                                                       );


#ifdef NORMALTEX_EXIST
    {
        float3 NormalMapNormal = normalize( 2.0f * (SampleStreaming(NormalTex, DefaultTexSampler, pin.InTexCoord, NormalStreamInfo).xyz ) - float3(1.0f,1.0f,1.0f) );
	    float3 BumpNormal = normalize(mul(NormalMapNormal.xyz , TangentToModelViewSpaceMatrix));

        output.NormalColor.xyz = BumpNormal;
    }
#else
    {
        output.NormalColor.xyz = pin.InNormal.xyz;
    }
#endif

#ifdef METALICTEX_EXIST
    {
        output.NormalColor.a = SampleStreaming(OcclusionRoughnessMetalicTex, DefaultTexSampler, pin.InTexCoord, MetalicStreamInfo).z;
    }
#else
    {
        output.NormalColor.a = Metalic;
    }
#endif

    //

    output.PositionColor = pin.InViewPosition;

    return output;
    
}
